# ==============================================================================
# UCAB Tasks - Environment Variables
# Copy this file to .env and configure your values
# ==============================================================================

# Application Port
PORT=3000

# MongoDB Connection URI
# For local development: mongodb://localhost:27017/ucab-tasks
# For Docker: mongodb://mongo:27017/ucab-tasks
MONGO_URI=mongodb://mongo:27017/ucab-tasks

# Node Environment
NODE_ENV=development
