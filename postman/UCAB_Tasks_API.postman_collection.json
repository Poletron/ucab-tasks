{
    "info": {
        "name": "UCAB Tasks API",
        "description": "Colección de Postman para probar la API REST de UCAB Tasks.\n\nAPI para gestión de notas desarrollada con NestJS siguiendo Clean Architecture.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "noteId",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Notes",
            "description": "Endpoints para gestión de notas",
            "item": [
                {
                    "name": "Create Note",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 201', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test('Response has correct structure', function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('id');",
                                    "    pm.expect(jsonData).to.have.property('title');",
                                    "    pm.expect(jsonData).to.have.property('content');",
                                    "    pm.expect(jsonData).to.have.property('createdAt');",
                                    "    pm.expect(jsonData).to.have.property('updatedAt');",
                                    "    ",
                                    "    // Save noteId for subsequent tests",
                                    "    pm.collectionVariables.set('noteId', jsonData.id);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Mi primera nota\",\n    \"content\": \"Este es el contenido de mi nota de prueba.\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/notes",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "notes"
                            ]
                        },
                        "description": "Crea una nueva nota con título y contenido."
                    }
                },
                {
                    "name": "Get All Notes",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response is an array', function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.be.an('array');",
                                    "});",
                                    "",
                                    "pm.test('Notes do not include content', function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    if (jsonData.length > 0) {",
                                    "        pm.expect(jsonData[0]).to.not.have.property('content');",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/notes",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "notes"
                            ]
                        },
                        "description": "Obtiene la lista de todas las notas (sin contenido)."
                    }
                },
                {
                    "name": "Get All Notes (Sorted by Title ASC)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Notes are sorted alphabetically', function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    if (jsonData.length > 1) {",
                                    "        pm.expect(jsonData[0].title.localeCompare(jsonData[1].title)).to.be.at.most(0);",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/notes?sortBy=title&order=asc",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "notes"
                            ],
                            "query": [
                                {
                                    "key": "sortBy",
                                    "value": "title"
